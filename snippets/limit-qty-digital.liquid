{%- comment -%}
  Limit quantity to 1 for digital download products.
  - Hides quantity selector on matching product pages
  - Intercepts /cart/add.js to prevent duplicate adds
  - Caps cart quantity to 1 as a fallback on ALL pages
  Targets: lettuce-wraps-and-sauce-cookbook-pdf
  ROLLBACK: replace this file with the v1 version (no fetch intercept)
{%- endcomment -%}

{%- assign digital_handles = 'lettuce-wraps-and-sauce-cookbook-pdf' | split: ',' -%}

{%- if product != blank and digital_handles contains product.handle -%}
  <style>
    .product-form__quantity { display: none !important; }
  </style>
{%- endif -%}

<script>
  (function() {
    var DIGITAL_HANDLES = ['lettuce-wraps-and-sauce-cookbook-pdf'];
    var MAX_QTY = 1;
    var _originalFetch = window.fetch;

    /* --- Intercept cart/add.js to block duplicate digital items --- */
    window.fetch = function(url, opts) {
      var urlStr = (typeof url === 'string') ? url : (url && url.url ? url.url : '');
      if (urlStr.indexOf('/cart/add') !== -1) {
        /* Check current cart first */
        return _originalFetch('/cart.js')
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            var dominated = false;
            cart.items.forEach(function(item) {
              if (DIGITAL_HANDLES.indexOf(item.handle) !== -1) {
                dominated = true;
              }
            });

            if (!dominated) {
              /* Product not in cart yet — allow the add */
              return _originalFetch(url, opts);
            }

            /* Digital product already in cart — parse the add request to see if it's a digital item */
            var addingDigital = false;
            try {
              if (opts && opts.body) {
                var bodyStr = typeof opts.body === 'string' ? opts.body : '';
                if (opts.body instanceof FormData) {
                  /* FormData — can't parse easily, redirect to cart */
                  window.location.href = '/cart';
                  return new Promise(function() {});
                }
                var bodyObj = JSON.parse(bodyStr);
                /* We can't easily map variant ID to handle here,
                   so if ANY digital product is already in cart,
                   block the add and redirect to cart */
                addingDigital = true;
              }
            } catch(e) {
              addingDigital = true;
            }

            if (addingDigital) {
              /* Redirect to cart — return a never-resolving promise
                 so Dawn's JS doesn't process a response and interfere */
              window.location.href = '/cart';
              return new Promise(function() {});
            }

            return _originalFetch(url, opts);
          });
      }
      return _originalFetch(url, opts);
    };

    /* --- Fallback: enforce limit on page load (safety net) --- */
    function enforceCartLimit() {
      _originalFetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          cart.items.forEach(function(item) {
            if (DIGITAL_HANDLES.indexOf(item.handle) !== -1 && item.quantity > MAX_QTY) {
              _originalFetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: item.key, quantity: MAX_QTY })
              }).then(function() { location.reload(); });
            }
          });
        });
    }

    /* --- Pre-checkout gate: enforce qty before Shopify checkout --- */
    function interceptCheckout() {
      /* Catch all checkout form submissions and link clicks */
      document.addEventListener('submit', function(e) {
        var form = e.target;
        var action = (form.getAttribute('action') || '').toLowerCase();
        if (action.indexOf('/checkout') !== -1 || action.indexOf('/cart') !== -1) {
          e.preventDefault();
          enforceAndCheckout(form);
        }
      }, true);

      /* Catch direct checkout links/buttons */
      document.addEventListener('click', function(e) {
        var el = e.target.closest('a[href*="/checkout"], button[name="checkout"]');
        if (el) {
          e.preventDefault();
          enforceAndCheckout(null);
        }
      }, true);
    }

    function enforceAndCheckout(form) {
      _originalFetch('/cart.js')
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          var needsFix = false;
          var fixes = [];
          cart.items.forEach(function(item) {
            if (DIGITAL_HANDLES.indexOf(item.handle) !== -1 && item.quantity > MAX_QTY) {
              needsFix = true;
              fixes.push(
                _originalFetch('/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: item.key, quantity: MAX_QTY })
                })
              );
            }
          });

          if (needsFix) {
            Promise.all(fixes).then(function() {
              window.location.href = '/checkout';
            });
          } else {
            /* Cart is clean — proceed to checkout */
            if (form) {
              form.submit();
            } else {
              window.location.href = '/checkout';
            }
          }
        })
        .catch(function() {
          /* If check fails, let them through rather than blocking */
          if (form) { form.submit(); } else { window.location.href = '/checkout'; }
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        enforceCartLimit();
        interceptCheckout();
      });
    } else {
      enforceCartLimit();
      interceptCheckout();
    }
  })();
</script>
